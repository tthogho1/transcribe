# Copy to .env and fill in the values:  cp .env.example .env
# Never commit .env. Values shown are the defaults the code uses when a
# variable is unset; "required" ones have no usable default.
# Comments must be on their own line (inline "# ..." can become part of a value).

# ---------------------------------------------------------------------------
# Chat server (src/api/chat_server.py, run_chat_server.py)
# ---------------------------------------------------------------------------
FLASK_HOST=0.0.0.0
# chat_server.py defaults to 7860 (Hugging Face Spaces); run_chat_server.py to 5000
FLASK_PORT=7860
FLASK_DEBUG=false
# Signs the user_id returned by /api/chat. Set a long random value in production,
# e.g. python -c "import secrets; print(secrets.token_hex(32))".
# If unset, a random key is used and issued user_ids stop working on restart.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Conversation memory (src/services/session/session_manager.py)
# ---------------------------------------------------------------------------
# If Redis can't be reached, sessions fall back to in-memory storage
# (lost on restart, not shared between processes).
REDIS_URL=redis://localhost:6379/0
SESSION_EXPIRY_SECONDS=1800
MAX_CONVERSATION_TURNS=20
MAX_CONVERSATION_TOKENS=4000

# ---------------------------------------------------------------------------
# OpenAI (required)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
# Small model for the follow-up check / query rewrite that runs before each search
OPENAI_REWRITE_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Zilliz Cloud / search (required)
# ---------------------------------------------------------------------------
ZILLIZ_URI=your-zilliz-cloud-uri
ZILLIZ_TOKEN=your-zilliz-cloud-token
# Collection used for search and embedding (dense + native BM25).
# Set it explicitly: the live collection is v2, and older code defaults to the
# deleted "conversation_chunks_bm25".
ZILLIZ_BM25_COLLECTION=conversation_chunks_bm25_v2
# Optional cross-encoder reranker; empty = off (e.g. cl-nagoya/ruri-v3-reranker-310m)
RERANKER_MODEL=
# Hybrid results re-scored per question when the reranker is on
RERANK_CANDIDATES=10
# Neighbouring chunks added around each hit (chunk = ~300 chars)
CONTEXT_CHUNKS_BEFORE=1
CONTEXT_CHUNKS_AFTER=3

# ---------------------------------------------------------------------------
# AWS (S3 / DynamoDB / SQS; ingestion scripts and transcription workers)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Only for temporary (STS) credentials; used by scripts/embed_missing_embeddings.py
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1
S3_BUCKET_NAME=your-s3-bucket-name
# SQS queue for src/services/aws/AmazonTranscribe.py and gladia_sqs_worker.py
SQS_QUEUE_URL=

# ---------------------------------------------------------------------------
# YouTube video table (DynamoDB)
# ---------------------------------------------------------------------------
# Defaults differ by script ("YoutubeList" or "youtube_videos"); set it explicitly.
YOUTUBE_DYNAMODB_TABLE=youtube_videos
# Used by add_embedding_attribute.py, embed_missing_embeddings.py,
# generate_embeddings_with_vectorizer.py and reingest_collection.py
DYNAMO_TABLE_NAME=YoutubeList

# ---------------------------------------------------------------------------
# Embedding / reingest scripts (scripts/)
# ---------------------------------------------------------------------------
# Bucket holding Gladia transcripts (defaults to S3_BUCKET_NAME in some scripts)
S3_TRANSCRIPT_BUCKET=audio4gladia
S3_TRANSCRIPT_PREFIX=
FILE_PATTERN={video_id}_transcription.json
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# ---------------------------------------------------------------------------
# Gladia transcription (src/services/aws/GladiaTranscribe.py, scripts/gladia_transcribe/)
# ---------------------------------------------------------------------------
GLADIA_API_KEY=your-gladia-api-key
GLADIA_API_URL=https://api.gladia.io/v2/
TRANSCRIBE_OUTPUT_BUCKET=audio4gladia
S3_INPUT_BUCKET=audio4input

# ---------------------------------------------------------------------------
# Hugging Face (optional)
# ---------------------------------------------------------------------------
# Read automatically by huggingface_hub / sentence-transformers when downloading
# models (higher rate limits, gated models). Not read by this repo's code directly.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Next.js app (typescript/) reads its own env file, e.g. typescript/.env.local:
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, S3_BUCKET_NAME,
#   YOUTUBE_DYNAMODB_TABLE, NEXT_PUBLIC_BASE_URL (optional; VERCEL_URL is set by Vercel)
# ---------------------------------------------------------------------------
